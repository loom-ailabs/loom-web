# Server secrets belong only in .dev.vars (local) or Cloudflare Secrets.
# Keep their .env.local values blank: OpenNext compiles .env files into Worker source.
# Copy to .env.local for next dev. Copy to .dev.vars for Workers preview.
APP_URL=http://localhost:3001
# Optional separate root page for provider sign-in buttons. Unset keeps the checkout page.
LOGIN_URL=http://localhost:3001
# Optional fixed homepage after website login. Defaults to APP_URL root.
AUTH_SUCCESS_URL=http://localhost:3000/
LOGTO_ENDPOINT=
# Immutable tenant namespace; pin the original endpoint before changing LOGTO_ENDPOINT.
# For the existing tenant: https://kpy72v.logto.app
LOGTO_USER_NAMESPACE=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
# Generate a random value with at least 32 characters. Never commit actual secrets.
LOGTO_COOKIE_SECRET=
# Local development remains test-only unless explicitly configured otherwise.
# Production requires STRIPE_MODE=live, matching Live objects and separate D1/Secrets.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Headshot package checkout uses Creem Test mode only (USD 9.99, one-time).
# Secrets stay in .dev.vars / Cloudflare Secrets; never put them in .env.local.
CREEM_MODE=test
CREEM_PRODUCT_ID=
CREEM_PRO_PRODUCT_ID=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
LOGTO_COOKIE_DOMAIN=

# Production: LOGIN_URL=https://login.loom-labs.ai and LOGTO_COOKIE_DOMAIN=.loom-labs.ai
# Local: LOGIN_URL=http://localhost:3001 and blank LOGTO_COOKIE_DOMAIN.
