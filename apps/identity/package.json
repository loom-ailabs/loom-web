{
  "name": "@hotkey-tools/identity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:migrate:local && next dev --webpack --port 3001",
    "build": "next build --webpack",
    "check-types": "next typegen && tsc --noEmit",
    "lint": "oxlint src scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:crypto": "node scripts/check-jose-runtime.mjs",
    "check:session": "node scripts/check-session-runtime.mjs",
    "start": "next start --port 3001",
    "cf:build": "node ../../scripts/check-worker-env.mjs && opennextjs-cloudflare build",
    "preview": "pnpm db:migrate:preview && pnpm cf:build && opennextjs-cloudflare preview --env preview --local --port 3001 --inspector-port 9301 --var APP_URL:http://localhost:3001 --var LOGIN_URL:http://localhost:3001 --var AUTH_SUCCESS_URL:http://localhost:3000/",
    "deploy": "node scripts/check-cloudflare.mjs && pnpm cf:build && opennextjs-cloudflare deploy",
    "deploy:dry-run": "pnpm cf:build && wrangler deploy --dry-run --outdir dist",
    "db:create": "wrangler d1 create loom-identity-production --update-config=false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --local --env preview",
    "db:migrate": "node scripts/check-cloudflare.mjs && wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@hotkey-tools/i18n": "workspace:*",
    "@hotkey-tools/identity-core": "workspace:*",
    "@hotkey-tools/ui": "workspace:*",
    "@opennextjs/cloudflare": "1.20.13",
    "creem": "1.13.0",
    "jose": "5.10.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.72.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "4.151.2"
  }
}
